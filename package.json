{
  "name": "soybean-ui",
  "version": "0.50.0",
  "private": true,
  "description": "SoybeanUI is built on top of SoybeanHeadless, providing a collection of styled components for Vue 3.",
  "homepage": "https://github.com/soybeanjs/soybean-ui",
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/soybean-ui.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:libs && pnpm build:headless && pnpm build:ui && pnpm build:sbean",
    "build:docs": "pnpm build:libs && pnpm --filter @soybeanjs/ui-docs build",
    "build:headless": "pnpm --filter @soybeanjs/headless build",
    "build:libs": "pnpm --filter @soybeanjs/theme build && pnpm --filter @soybeanjs/ui-uno build",
    "build:sbean": "pnpm --filter sbean build",
    "build:ui": "pnpm --filter @soybeanjs/ui build",
    "check:deps": "pnpm sui check deps",
    "check:generated": "pnpm sui check generated",
    "check:size": "pnpm sui check size",
    "commit": "soy git-commit",
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter @soybeanjs/ui-docs dev",
    "fmt": "vp fmt",
    "lint": "vp lint --fix && pnpm lint:vue",
    "lint:vue": "eslint --ext .vue --fix packages/ apps/docs/",
    "preview": "pnpm --filter @soybeanjs/ui-docs preview",
    "publish-pkg": "pnpm publish -r --access public",
    "release": "soy release -e 'pnpm release-execute'",
    "release-execute": "pnpm soy changelog && pnpm sui gen skills && pnpm sui translate all && pnpm sync-template-versions",
    "size": "pnpm sui size",
    "stub": "pnpm sui stub",
    "sui": "tsx packages/scripts/src/index.ts",
    "sync-template-versions": "pnpm sui sync-template-versions",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @soybeanjs/ui test:e2e",
    "typecheck": "pnpm -r typecheck",
    "upkg": "soy ncu"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.9.1"
}
