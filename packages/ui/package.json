{
  "name": "@vean/ui",
  "version": "0.50.0",
  "description": "Vean is built on top of Vean Aria, providing a collection of styled components for Vue 3.",
  "homepage": "https://github.com/soybeanjs/vean-ui",
  "bugs": {
    "url": "https://github.com/soybeanjs/vean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/vean-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./nuxt": "./src/nuxt/index.ts",
    "./resolver": "./src/resolver/index.ts",
    "./*": "./src/components/*/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js"
      },
      "./nuxt": {
        "types": "./dist/nuxt/index.d.ts",
        "import": "./dist/nuxt/index.js",
        "require": "./dist/nuxt/index.js"
      },
      "./resolver": {
        "types": "./dist/resolver/index.d.ts",
        "import": "./dist/resolver/index.js",
        "require": "./dist/resolver/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./*": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/components/*/index.js",
        "require": "./dist/components/*/index.js"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack && pnpm build:css",
    "build:css": "unocss --minify",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "vitest run --config vitest.browser.config.ts",
    "test:e2e:ui": "vitest --ui --config vitest.browser.config.ts",
    "test:e2e:update": "vitest run --config vitest.browser.config.ts --update",
    "test:e2e:watch": "vitest watch --config vitest.browser.config.ts",
    "test:ui": "vp test --ui",
    "test:watch": "vp test watch",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@soybeanjs/colord": "^0.8.1",
    "@soybeanjs/cva": "^0.1.1",
    "@vean/aria": "workspace:^",
    "@vean/theme": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@unocss/cli": "^66.10.5",
    "@vean/unocss": "workspace:^",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.6.0",
    "playwright": "^1.64.0",
    "typescript": "catalog:",
    "unocss": "^66.10.5",
    "unplugin-vue": "^8.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plus": "catalog:",
    "vitest": "5.0.3",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.3.0",
    "@nuxt/schema": "^4.3.0",
    "nuxt": ">=4.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vue": ">=3.2.0",
    "vue-router": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  }
}
