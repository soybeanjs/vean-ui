---
/**
 * Port of `apps/docs/src/pages/chart/[name].vue`.
 *
 * Same hero block (back-to-catalog link, kind badge, title, description, related
 * kind chips) and the same playground gallery below it. The ubean page is a Vue
 * route component; here the hero is build-time markup and only the demos hydrate,
 * so the gallery keeps the same island shape as the component pages.
 */
import { createTranslator, type Locale } from '../i18n';
import { CHART_KINDS } from '../plugin/routes';
import { renderIcon } from '../plugin/icons';
import PlaygroundGallery from './PlaygroundGallery.astro';

interface Props {
  kind: string;
  locale: Locale;
  codeHtml?: Record<string, string>;
}

const { kind, locale, codeHtml } = Astro.props;
const t = createTranslator(locale);

const pascal = (value: string): string =>
  value
    .split('-')
    .map(part => part.charAt(0).toUpperCase() + part.slice(1))
    .join('');

const title = pascal(kind);
const description = t(`chart.kinds.${kind}`, '');
const related = CHART_KINDS.filter(item => item !== kind);
---

<div class="mx-auto max-w-screen-2xl space-y-6 pb-8">
  <section
    class="relative overflow-hidden px-6 py-7 border border-border/50 dark:border-border rounded-xl sm:px-8 sm:py-9 xl:px-10"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,hsl(var(--primary-400)/0.12),transparent_30%),radial-gradient(circle_at_bottom_left,hsl(var(--primary-700)/0.07),transparent_28%)]"
    >
    </div>

    <div class="relative space-y-5">
      <a
        href={locale === 'en' ? '/chart' : '/zh/chart'}
        class="group -ml-2 inline-flex items-center gap-2 rounded-md px-2 py-1 text-sm font-medium text-accent-foreground transition-colors hover:bg-accent"
      >
        <Fragment set:html={renderIcon('lucide:arrow-left', { class: 'transition-transform duration-200 group-hover:-translate-x-1' })} />
        {t('component_detail.actions.catalog')}
      </a>

      <div
        class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted-foreground"
      >
        <Fragment set:html={renderIcon('lucide:bar-chart-3', { class: 'text-sm text-primary' })} />
        <span>{t('layout.header.chart')}</span>
      </div>

      <div class="space-y-3">
        <p class="text-3xl font-black tracking-[-0.05em] text-foreground">{title}</p>
        <p class="max-w-3xl text-sm leading-7 text-muted-foreground sm:text-base">{description}</p>
      </div>

      <div class="flex flex-wrap gap-2">
        {
          related.map(item => (
            <a
              href={`${locale === 'en' ? '' : '/zh'}/chart/${item}`}
              class="inline-flex items-center rounded-full border border-border px-3 py-1 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              {pascal(item)}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <PlaygroundGallery component={kind} locale={locale} codeHtml={codeHtml} />
</div>
