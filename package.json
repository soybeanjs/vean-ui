{
  "name": "vean",
  "version": "0.50.1",
  "private": true,
  "description": "Vean is a Vue 3 component library built on a 'aria / styled separation'.",
  "homepage": "https://github.com/soybeanjs/vean-ui",
  "bugs": {
    "url": "https://github.com/soybeanjs/vean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/vean-ui.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:libs && pnpm build:aria && pnpm build:ui && pnpm build:cli",
    "build:aria": "pnpm --filter @vean/aria build",
    "build:cli": "pnpm --filter @vean/cli build",
    "build:docs": "pnpm build:libs && pnpm --filter @vean/docs build",
    "build:libs": "pnpm --filter @vean/theme build && pnpm --filter @vean/unocss build",
    "build:ui": "pnpm --filter @vean/ui build",
    "check:deps": "pnpm sui check deps",
    "check:generated": "pnpm sui check generated",
    "check:size": "pnpm sui check size",
    "commit": "soy git-commit",
    "dev": "pnpm dev:docs",
    "dev:docs": "pnpm --filter @vean/docs dev",
    "fmt": "vp fmt",
    "lint": "vp lint --fix && pnpm lint:vue",
    "lint:vue": "eslint --ext .vue --fix packages/ apps/docs/",
    "preview": "pnpm --filter @vean/docs preview",
    "publish-pkg": "pnpm publish -r --access public",
    "release": "soy release -e 'pnpm release-execute'",
    "release-execute": "pnpm soy changelog && pnpm sui gen skills && pnpm sui translate all && pnpm sync-template-versions",
    "size": "pnpm sui size",
    "stub": "pnpm sui stub",
    "sui": "tsx packages/scripts/src/index.ts",
    "sync-template-versions": "pnpm sui sync-template-versions",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @vean/ui test:e2e",
    "typecheck": "pnpm -r typecheck",
    "upkg": "soy ncu"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.10.1"
}
