{
  "name": "@vean/theme",
  "version": "0.50.0",
  "description": "The Vean theme engine: a static palette layer plus a declarative semantic alias layer (no measurement or correction).",
  "homepage": "https://github.com/soybeanjs/vean-ui",
  "bugs": {
    "url": "https://github.com/soybeanjs/vean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/vean-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js",
      "require": "./dist/storage.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "require": "./dist/ssr.js"
    },
    "./palette.css": "./dist/palette.css"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack && pnpm build:palette",
    "build:palette": "tsx scripts/emit-palette.mts",
    "test": "vp test",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@soybeanjs/colord": "^0.8.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.3"
  }
}
