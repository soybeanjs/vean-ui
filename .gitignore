# `sui size` output: the report is disposable and the baseline is restored from
# the CI cache, so neither belongs in git.
.size-cache/
.size-report/

/cypress/videos/
/cypress/screenshots/
.vitest-attachments/
.vitest/attachments
packages/ui/.vitest/attachments
# Failure screenshots and legacy artifacts — disposable, never committed.
# Visual-regression baselines are the opposite: they live in `__vrt__/` and MUST
# be committed (see packages/ui/vitest.browser.config.ts).
__screenshots__/

