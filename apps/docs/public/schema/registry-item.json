{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "A single item in the vean registry. Represents a component, style, utility, or theme.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "JSON Schema reference for this item."
        },
        "extends": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The name of the item. Unique within the registry. This is the identifier used by `vean add <name>`."
        },
        "package": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "description": "A human-readable title for the item."
        },
        "author": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "description": "A short description of the item, shown in search results and the UI."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "npm package dependencies required by this item."
        },
        "devDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "npm package devDependencies required by this item."
        },
        "registryDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other registry items that this item depends on. They will be added automatically when this item is added."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "registry:ui",
                  "registry:component",
                  "registry:style",
                  "registry:lib",
                  "registry:hook",
                  "registry:theme"
                ],
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "required": ["path", "type"]
          },
          "description": "The files that belong to this registry item."
        },
        "uno": {
          "type": "object",
          "properties": {
            "presets": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Preset module specifiers to load (e.g. \"@vean/unocss\")."
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "array",
                "items": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "minItems": 2
              },
              "description": "Declarative `[pattern, class]` rules. Pattern is a regex source string; the second element is the replacement class."
            },
            "shortcuts": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              },
              "description": "Shortcut name → class string mapping."
            },
            "theme": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "UnoCSS theme object — open shape for colors, shadows, fonts, etc."
            },
            "safelist": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tokens to always generate, regardless of content scanning."
            }
          },
          "required": [],
          "description": "UnoCSS config fragment (ADR-005). A JSON-serializable slice of UnoCSS UserConfig — presets, rules, shortcuts, theme, safelist — that ships declaratively with the item and merges during `vean add`."
        },
        "cssVars": {
          "type": "object",
          "properties": {
            "light": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "dark": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": []
        },
        "css": {
          "type": "string"
        },
        "meta": {
          "type": "object",
          "properties": {
            "registryNamespace": {
              "type": "string"
            },
            "registryUrl": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tags for categorising the item."
            },
            "updated": {
              "type": "string"
            },
            "created": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [],
          "description": "Metadata for the registry item."
        },
        "docs": {
          "type": "string",
          "description": "Documentation URL or inline documentation for the item."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Categories for organising items in the registry UI."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview": {
          "type": "string",
          "description": "URL or path to a preview image for the item."
        },
        "deprecated": {
          "type": "boolean"
        },
        "type": {
          "const": "registry:base",
          "description": "The item type. Determines the target directory and how the item is resolved in the user's project."
        },
        "config": {
          "type": "object",
          "properties": {
            "uno": {
              "type": "object",
              "properties": {
                "base": {
                  "enum": ["slate", "mist", "gray", "zinc", "neutral", "stone", "taupe", "olive", "mauve"],
                  "type": "string",
                  "description": "Base color palette for backgrounds and borders."
                },
                "primary": {
                  "enum": [
                    "slate",
                    "mist",
                    "gray",
                    "zinc",
                    "neutral",
                    "stone",
                    "taupe",
                    "olive",
                    "mauve",
                    "red",
                    "orange",
                    "amber",
                    "yellow",
                    "lime",
                    "green",
                    "emerald",
                    "teal",
                    "cyan",
                    "sky",
                    "blue",
                    "indigo",
                    "violet",
                    "purple",
                    "fuchsia",
                    "pink",
                    "rose"
                  ],
                  "type": "string",
                  "description": "Primary brand color for accents and actions."
                },
                "size": {
                  "enum": ["xs", "sm", "md", "lg", "xl", "2xl"],
                  "type": "string",
                  "description": "Component size/density preset."
                },
                "radius": {
                  "enum": ["2xs", "xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl"],
                  "type": "string",
                  "description": "Default border radius for components."
                }
              },
              "required": [],
              "description": "UnoCSS theme palette — base/primary/size/radius picklists."
            },
            "aliases": {
              "type": "object",
              "properties": {
                "ui": {
                  "type": "string",
                  "description": "Alias for the UI components directory."
                },
                "theme": {
                  "type": "string",
                  "description": "Alias for the theme tokens directory."
                },
                "styles": {
                  "type": "string",
                  "description": "Alias for the style recipes directory."
                },
                "components": {
                  "type": "string",
                  "description": "Alias for the components directory."
                },
                "composables": {
                  "type": "string",
                  "description": "Alias for the composables directory."
                }
              },
              "required": [],
              "description": "Path aliases for the project source directories."
            },
            "themePackage": {
              "type": "string",
              "description": "Theme token package, e.g. \"@vean/theme\"."
            },
            "resolver": {
              "type": "string",
              "description": "Resolver module path (relative to project root), e.g. \"./src/ui/resolver\"."
            },
            "iconLibrary": {
              "enum": ["lucide", "material-symbols", "ph", "tabler", "solar", "radix-icons"],
              "type": "string",
              "description": "The Iconify icon set to use via SIcon."
            },
            "rtl": {
              "type": "boolean",
              "description": "Enable right-to-left text direction."
            },
            "pointer": {
              "enum": ["coarse", "fine"],
              "type": "string",
              "description": "Pointer precision hint: \"coarse\" (touch) or \"fine\" (mouse/stylus)."
            }
          },
          "required": [],
          "description": "Typed Vean base config (ADR-009). Only present on `registry:base` items. Deep-partial of veanBaseConfigSchema — any subset of the Vean project shape (uno palette, aliases, themePackage, resolver, iconLibrary, rtl, pointer) can be declared."
        }
      },
      "required": ["name", "type"],
      "description": "A single item in the vean registry. Represents a component, style, utility, or theme."
    },
