{
  "name": "@vean/docs",
  "version": "0.51.4",
  "private": true,
  "description": "Vean Docs is a documentation for Vean. It is designed to be easy to use and understand.",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:registry && ubean build && pnpm build:seo",
    "build:registry": "pnpm --filter @vean/cli build:registry && vp fmt public/r --write",
    "build:schema": "pnpm --filter @vean/cli build:schema",
    "build:seo": "tsx build/seo.ts",
    "dev": "ubean dev",
    "prepare": "ubean prepare",
    "preview": "ubean preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.4",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@soybeanjs/colord": "^0.8.1",
    "@tanstack/charts": "^1.1.0",
    "@ubean/content": "^0.7.11",
    "@unhead/vue": "^3.4.3",
    "@vean/aria": "workspace:^",
    "@vean/theme": "workspace:^",
    "@vean/ui": "workspace:^",
    "@vueuse/core": "^15.0.0",
    "d3-shape": "^3.2.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.5.0",
    "ubean": "^0.7.11",
    "valibot": "^1.5.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@soybeanjs/unocss-preset": "^0.2.0",
    "@types/d3-shape": "^3.2.0",
    "@vean/unocss": "workspace:^",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "typescript": "catalog:",
    "unocss": "^66.12.0",
    "vite-plus": "catalog:"
  }
}
