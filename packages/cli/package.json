{
  "name": "@vean/cli",
  "version": "0.50.0",
  "description": "CLI tool for adding Vean components to your Vue apps — copy-paste, like shadcn/ui.",
  "homepage": "https://github.com/soybeanjs/vean-ui/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/soybeanjs/vean-ui/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soybeanjs/vean-ui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "vean": "./src/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./schema": "./src/schema.ts",
    "./preset": "./src/preset.ts",
    "./utils": "./src/utils.ts",
    "./mcp": "./src/mcp.ts"
  },
  "publishConfig": {
    "bin": {
      "vean": "./dist/index.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.js"
      },
      "./registry": {
        "types": "./dist/registry/index.d.ts",
        "import": "./dist/registry/index.js",
        "require": "./dist/registry/index.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js",
        "require": "./dist/schema/index.js"
      },
      "./preset": {
        "types": "./dist/preset/index.d.ts",
        "import": "./dist/preset/index.js",
        "require": "./dist/preset/index.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "import": "./dist/utils/index.js",
        "require": "./dist/utils/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp/index.d.ts",
        "import": "./dist/mcp/index.js",
        "require": "./dist/mcp/index.js"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "build:registry": "tsx src/index.ts build packages/cli/registry.json -o ../../apps/docs/public/r --cwd ../..",
    "build:schema": "tsx scripts/schema.ts",
    "clean": "rimraf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vean/theme": "workspace:^",
    "commander": "^15.0.0",
    "dedent": "^1.7.2",
    "deepmerge": "^4.3.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "kleur": "^4.1.5",
    "ora": "^9.4.1",
    "prompts": "^2.4.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.4",
    "@types/prompts": "^2.4.9",
    "@valibot/to-json-schema": "^1.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.3"
  }
}
